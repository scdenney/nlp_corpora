{
  "name": "Xcavator",
  "description": "Collect visible posts from one X account into a local research corpus",
  "version": "1.1",
  "manifest_version": 3,
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://127.0.0.1:3000/*"],
  "background": { "scripts": ["background.js"], "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
   "16": "Xcavator.png",
   "32": "Xcavator.png",
   "48": "Xcavator.png",
   "128": "Xcavator.png"
 }
}
